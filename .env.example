# Copy this file to .env and fill in your values
# cp .env.example .env

# Admin dashboard password (CHANGE THIS!)
ADMIN_PASSWORD=changeme123

# Port the server listens on
PORT=3001

# Allowed origin for CORS (your PWA URL)
# Use * to allow all during development, restrict in production
CORS_ORIGIN=*

# Secret key for session tokens (generate a random string)
SESSION_SECRET=replace_with_a_long_random_string_here
